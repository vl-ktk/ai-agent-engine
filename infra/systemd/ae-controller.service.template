# Stage 4.2: source-only unit; NEVER install/enable without separate owner approval.
# Requires a verified release in /opt/ai-agent-engine/current/venv.
# Controller currently manages lifecycle/health only (no task orchestration yet).
[Unit]
Description=AI Agent Engine controller (single-owner)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=30s
TimeoutStartSec=30s
User=ae-runtime
Group=ae-runtime
WorkingDirectory=/opt/ai-agent-engine/current
ExecStart=/opt/ai-agent-engine/current/venv/bin/python -m ai_agent_engine.controller run --interval 5
ExecStartPost=/opt/ai-agent-engine/current/venv/bin/python -m ai_agent_engine.controller check --max-age 15
Restart=on-failure
RestartSec=5
UMask=0077
StateDirectory=ai-agent-engine
StateDirectoryMode=0700
RuntimeDirectory=ai-agent-engine
RuntimeDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=300

[Install]
WantedBy=multi-user.target
