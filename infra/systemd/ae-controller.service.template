# Stage 4.2 / 6.3: concrete controller executable, NOT INSTALLED on VPS.
# Requires approved immutable wheel in /opt/ai-agent-engine/current/venv first.
# Install/enable only with separate owner approval; no automatic CI deployment.
[Unit]
Description=AI Agent Engine controller (single-owner)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=exec
User=ae-runtime
Group=ae-runtime
WorkingDirectory=/opt/ai-agent-engine/current
ExecStart=/opt/ai-agent-engine/current/venv/bin/python -m ai_agent_engine.controller serve --state-dir /var/lib/ai-agent-engine
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
UMask=0077
StateDirectory=ai-agent-engine
StateDirectoryMode=0700
RuntimeDirectory=ai-agent-engine
RuntimeDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes
LockPersonality=yes
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=30s
LogRateLimitBurst=300

[Install]
WantedBy=multi-user.target
